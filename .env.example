# Server & App Environment
PORT=3001
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://ashabani.com

# Authentication (64+ char random hex string: generate on VPS with `openssl rand -hex 32`)
JWT_SECRET_KEY=your_strong_random_jwt_secret_key_here

# Database (PostgreSQL - Neon.tech, Supabase, or self-hosted VPS PostgreSQL)
# Example for Neon/Supabase: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/dandiya2026?schema=public"

# Payment Gateway (Razorpay LIVE / TEST credentials)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@ashabani.com
DEFAULT_ADMIN_PASSWORD=admin@ashabani2026

# TextBee SMS Gateway (https://textbee.dev - No DLT required)
TEXTBEE_API_KEY=your_textbee_api_key_here
# Optional: Specific Android device ID from TextBee app (leave blank to use default registered device)
TEXTBEE_DEVICE_ID=
# Optional: Specific SIM subscription ID on multi-SIM phones (e.g. 1, 2, 7 etc. shown in TextBee app)
TEXTBEE_SIM_ID=

